{
  "name": "dimenzn-shop",
  "version": "0.0.1",
  "description": "Join Dimenzn marketplace.Shop securely, sell your products, track orders and earn your reputation of trust.",
  "productName": "Dimenzn",
  "author": "Zoran Velickovic",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "// ---> THE MAGIC DEV BUTTONS <---": "",
    "dev": "concurrently -k -p \"[{name}]\" -n \"FRONT,BACK\" -c \"blue,cyan\" \"npm run develop\" \"npm run dev:backend\"",
    "dev:warp": "concurrently -k -p \"[{name}]\" -n \"FRONT,BACK\" -c \"blue,cyan\" \"npm run develop:warp\" \"npm run dev:warp:backend\"",
    "// ---> LOCAL BACKEND SCRIPTS <---": "",
    "dev:backend": "NODE_ENV=development MARKET_ENV=test nodemon server.js",
    "dev:warp:backend": "NODE_ENV=development MARKET_ENV=test TIME_WARP=true TIME_MULTIPLIER=3600 nodemon server.js",
    "// ---> LOCAL FRONTEND SCRIPTS <---": "",
    "develop": "MARKET_ENV=test quasar dev",
    "develop:warp": "MARKET_ENV=test FRONT_WARP=true quasar dev",
    "// ---> BUILD & PIPELINE SCRIPTS <---": "",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "// ---> LOCAL DEPLOYMENT TRIGGERS <---": "",
    "deploy:test": "git add . && git commit -m \"Pushing to test server\" && git push origin dev",
    "deploy:prod": "git checkout main && git merge dev --no-edit && git push origin main && git checkout dev",
    "// ---> PRODUCTION SERVER SCRIPTS (Used by GitHub Actions) <---": "",
    "start": "NODE_ENV=production node server.js",
    "pm2:rs": "pm2 start ecosystem.config.cjs --only dimenzn-rs",
    "pm2:th": "pm2 start ecosystem.config.cjs --only dimenzn-th",
    "pm2:test": "pm2 start ecosystem.config.cjs --only dimenzn-test",
    "pm2:all": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "@sinonjs/fake-timers": "^15.2.2",
    "@stripe/stripe-js": "^8.9.0",
    "apexcharts": "^5.10.4",
    "axios": "^1.2.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "connect-history-api-fallback": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "html2pdf.js": "^0.14.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "mongoose": "^8.12.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^5.1.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "resend": "^6.12.0",
    "serve-static": "^1.16.2",
    "stripe": "^20.4.0",
    "vue": "^3.4.18",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.0.0",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@quasar/app-vite": "^2.3.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "vite-plugin-checker": "^0.9.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  }
}
